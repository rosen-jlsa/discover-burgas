# Public origin embedded in permanent QR codes. No trailing slash.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Neon: pooled runtime connection and direct migration connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional future Google Maps Embed/JavaScript integration. Current navigation links do not need a key.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
