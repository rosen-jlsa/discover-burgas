# Public origin embedded in permanent QR codes. No trailing slash.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Supabase project. Publishable key may be used for public reads under RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server only: required for seeding and the private issue-report inbox.
SUPABASE_SECRET_KEY=your-supabase-server-secret

# Production must use the database and fail closed instead of falling back to the manifest.
CONTENT_BACKEND=manifest

# Optional server-only Google Places photo integration (Places API New; billing and API restrictions required).
# Never expose this key with NEXT_PUBLIC_ or commit its value.
# GOOGLE_PLACES_API_KEY=

# Protects /admin. Use a long random value and never commit a real production token.
ADMIN_DASHBOARD_TOKEN=replace-with-a-long-random-secret

# Server-only HMAC secret used to create one-way abuse-prevention fingerprints.
# Generate independently for production. ADMIN_DASHBOARD_TOKEN is used only as a local fallback.
REPORT_RATE_LIMIT_SECRET=replace-with-another-long-random-secret

# Optional immutable build identity (Vercel commit identity is detected automatically).
# APP_BUILD_ID=release-1.1.0
# APP_BUILT_AT=2026-11-21T20:00:00Z
# Android signing values belong in the build environment, never in NEXT_PUBLIC_*.
# See docs/PWA_AND_ANDROID.md for local signing and CI secrets.
