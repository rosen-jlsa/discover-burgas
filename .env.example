# Public origin embedded in permanent QR codes. No trailing slash.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Supabase project. Publishable key may be used for public reads under RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server only: required for seeding and the private issue-report inbox.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Production must use the database and fail closed instead of falling back to the manifest.
CONTENT_BACKEND=manifest

# Optional Google Maps Platform integration. Existing Google/Apple/Waze direction links need no key.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Protects /admin. Use a long random value and never commit a real production token.
ADMIN_DASHBOARD_TOKEN=replace-with-a-long-random-secret
